{
  "manifest_version": 3,
  "name": "BlueFox Stats",
  "version": "0.2",
  "description": "Extension avancée de statistiques YouTube avec interface modernisée et corrections critiques",
  "default_locale": "fr",
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "BlueFox Stats v0.2"
  },
  "permissions": [
    "activeTab",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "https://www.googleapis.com/*",
    "https://returnyoutubedislikeapi.com/*",
    "https://i.ytimg.com/*"
  ],
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "css": ["styles/content.css"],
      "js": ["content/content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["styles/*"],
      "matches": ["*://*.youtube.com/*"]
    }
  ]
}
