{
  "manifest_version": 3,
  "name": "BlueFox Stats",
  "version": "0.1",
  "description": "Extension avancée de statistiques YouTube",
  "default_locale": "fr",
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "BlueFox Stats v0.1"
  },
  "permissions": [
    "activeTab",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "https://www.googleapis.com/*",
    "https://returnyoutubedislikeapi.com/*",
    "https://i.ytimg.com/*"
  ],
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "css": ["styles/content.css"],
      "js": [
        "utils/logger.js",
        "utils/cache.js",
        "utils/errorHandler.js",
        "utils/helpers.js",
        "utils/api.js",
        "utils/i18n.js",
        "utils/manager.js",
        "content/content.js",
        "content/init.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["styles/*"],
      "matches": ["*://*.youtube.com/*"]
    }
  ]
}
