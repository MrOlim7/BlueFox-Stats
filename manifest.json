{
  "manifest_version": 3,
  "name": "BlueFox Stats",
  "version": "0.1",
  "description": "Advanced YouTube Stats Extension",
  "default_locale": "fr",
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "BlueFox Stats v0.1"
  },
  "permissions": [
    "activeTab",
    "storage",
    "contextMenus",
    "tabs"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "https://www.googleapis.com/*",
    "https://returnyoutubedislikeapi.com/*",
    "https://i.ytimg.com/*",
    "https://yt3.ggpht.com/*"
  ],
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "css": ["styles/content.css"],
      "js": [
        "utils/helpers.js",
        "utils/api.js",
        "content/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/*", "styles/*"],
      "matches": ["*://*.youtube.com/*"]
    }
  ]
}
